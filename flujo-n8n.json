    {
      "id": "0257f0fa-2ab8-4a1d-96e4-f0683c3e64cd",
      "name": "Claude Triage",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        1344,
        368
      ],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "claude-haiku-5-5"
        },
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Cliente: {{ $(\"Normalizar Ticket\").item.json.nombre }} <{{ $(\"Normalizar Ticket\").item.json.email }}>\nAsunto: {{ $(\"Normalizar Ticket\").item.json.asunto }}\nMensaje: {{ $(\"Normalizar Ticket\").item.json.mensaje }}"
            }
          ]
        },
        "simplify": true,
        "options": {
          "maxTokens": 1500,
          "system": "Eres un agente de triage de soporte tecnico. Responde SOLO con un JSON valido con las claves: categoria (Facturacion|Tecnico|Cuenta|Otro), urgencia (entero 1-5), resumen (max 20 palabras), respuesta (borrador cordial de respuesta al cliente, max 80 palabras, en el idioma del cliente)."
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "944911fa-540d-4a1b-9f65-12a10431a74c",
      "name": "Parsear Respuesta IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        288
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const j = $input.item.json;\nconst blocks = Array.isArray(j.content) ? j.content : [];\nconst textBlock = blocks.find(b => b.type === 'text');\nconst raw = textBlock?.text ?? j.text ?? j.output ?? '';\nconst m = String(raw).match(/\\{[\\s\\S]*\\}/);\nif (!m) throw new Error('Respuesta de IA sin JSON: ' + String(raw).slice(0, 200));\nconst d = JSON.parse(m[0]);\nconst cats = ['Facturacion', 'Tecnico', 'Cuenta', 'Otro'];\nreturn { json: {\n  categoria: cats.includes(d.categoria) ? d.categoria : 'Otro',\n  urgencia: Number(d.urgencia) || 3,\n  resumen: String(d.resumen || ''),\n  respuesta: String(d.respuesta || '')\n} };"
      },
      "onError": "continueErrorOutput"
    },
